# === E.V. configuration ===
# Copy this file to ".env" and fill in the values:
#   cp .env.example .env

# --- Required ---

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# Gemini API key (https://aistudio.google.com/apikey)
# Also used for semantic-memory embeddings.
GEMINI_API_KEY=

# Primary Gemini model. "gemini-flash-latest" always points to the current
# Flash, so it never goes stale.
EV_MODEL=gemini-flash-latest

# Your Telegram user ID (optional but RECOMMENDED): locks the bot to you only.
# Send /start and read it from the logs. Leave empty to answer everyone.
EV_OWNER_ID=

# --- Voice ---

# Reply with voice too? (true/false)
EV_VOICE_REPLY=true

# edge-tts voice (PT-BR): pt-BR-FranciscaNeural (female),
# pt-BR-ThalitaMultilingualNeural (female), pt-BR-AntonioNeural (male)
EV_VOICE=pt-BR-FranciscaNeural
# Fine-tuning to sound softer: higher pitch, slightly slower.
EV_VOICE_RATE=-3%
EV_VOICE_PITCH=+12Hz

# --- Fallback providers (optional) ---
# If set, E.V. falls back to these when Gemini is rate-limited.
# Leave empty to disable a provider.

# Groq (https://console.groq.com/keys) — chat model + Whisper (transcription).
# gpt-oss-120b is reliable at function calling (memory/reminders/tools).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter (https://openrouter.ai/keys) — variety of open models.
# NOTE: ":free" models change over time. On a 404, pick a current free model at
# https://openrouter.ai/models?max_price=0 and update here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Memory & reminders ---

# Embedding model for semantic memory recall (uses GEMINI_API_KEY).
EV_EMBED_MODEL=gemini-embedding-001
# Timezone used to turn "tomorrow at 9am" into an absolute time.
EV_TIMEZONE=America/Sao_Paulo
# How often the scheduler checks for due reminders (seconds).
EV_REMINDER_POLL_SECONDS=30

# --- Tools ---

# Web search (DuckDuckGo, no key). true/false.
EV_WEBSEARCH_ENABLED=true

# Google Calendar & email (optional). Path to an OAuth client secret JSON
# downloaded from Google Cloud Console. Leave empty to disable these tools.
# The first run opens a browser to authorize; the token is cached next to it.
GOOGLE_OAUTH_CLIENT=
GOOGLE_TOKEN_PATH=google_token.json
