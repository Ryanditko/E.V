# === E.V. configuration ===
# Copy this file to ".env" and fill in the values:
#   cp .env.example .env

# --- Required ---

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=

# Gemini API key (https://aistudio.google.com/apikey)
# Also used for semantic-memory embeddings.
GEMINI_API_KEY=

# Primary Gemini model. "gemini-flash-latest" always points to the current
# Flash, so it never goes stale.
EV_MODEL=gemini-flash-latest

# Your Telegram user ID (optional but RECOMMENDED): locks the bot to you only.
# Send /start and read it from the logs. Leave empty to answer everyone.
EV_OWNER_ID=

# --- Voice ---

# Reply with voice too? (true/false)
EV_VOICE_REPLY=true

# edge-tts voice (PT-BR): pt-BR-FranciscaNeural (female),
# pt-BR-ThalitaMultilingualNeural (female), pt-BR-AntonioNeural (male)
EV_VOICE=pt-BR-FranciscaNeural
# Fine-tuning. Keep pitch at +0Hz for the most NATURAL voice — shifting pitch
# makes edge-tts sound robotic. Adjust rate (e.g. -5%) for slower speech.
EV_VOICE_RATE=+0%
EV_VOICE_PITCH=+0Hz
# Pronunciation fixes for the AUDIO only (text stays the same). Semicolon-
# separated "from=to". Ex so the PT-BR voice says names right: Ryan=Rian
EV_VOICE_FIXES=

# Gemini TTS (optional, more natural than edge-tts). Uses GEMINI_API_KEY —
# no separate key needed. Falls back to edge-tts on any error/quota limit.
EV_GEMINI_TTS=false
EV_GEMINI_VOICE=Kore

# --- Fallback providers (optional) ---
# If set, E.V. falls back to these when Gemini is rate-limited.
# Leave empty to disable a provider.

# Groq (https://console.groq.com/keys) — chat model + Whisper (transcription).
# gpt-oss-120b is reliable at function calling (memory/reminders/tools).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter (https://openrouter.ai/keys) — variety of open models.
# NOTE: ":free" models change over time. On a 404, pick a current free model at
# https://openrouter.ai/models?max_price=0 and update here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Local model (Ollama): never-runs-out safety net ---
# Cloud providers are tried first; when they're all rate-limited, E.V. falls
# back to a local Ollama model (no quota). Requires Ollama installed and a model
# pulled (e.g. `ollama pull llama3.1`). Set OLLAMA_ENABLED=false to turn it off.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Memory & reminders ---

# Embedding backend for semantic memory + knowledge base: "gemini" or "ollama".
# "ollama" is fully local/no-quota (needs `ollama pull nomic-embed-text`).
EV_EMBED_BACKEND=gemini
# Gemini embedding model (used when EV_EMBED_BACKEND=gemini).
EV_EMBED_MODEL=gemini-embedding-001
# Timezone used to turn "tomorrow at 9am" into an absolute time.
EV_TIMEZONE=America/Sao_Paulo
# How often the scheduler checks for due reminders (seconds).
EV_REMINDER_POLL_SECONDS=30
# Local hour (0-23) for the automatic daily briefing to the owner. Empty disables.
EV_BRIEFING_HOUR=8
# Local hour for a proactive check-in ("how was your day?"). Empty disables.
EV_CHECKIN_HOUR=
# City for weather in the briefing (empty disables). Ex: Sao Paulo
EV_CITY=
# Topic for news headlines in the briefing (empty disables). Ex: Brasil tecnologia
EV_NEWS_TOPIC=
# Weekly review: weekday (0=Mon..6=Sun) and hour. Empty day disables.
EV_WEEKLY_DAY=6
EV_WEEKLY_HOUR=20
# Rain alert: local hour to check tomorrow's forecast (needs EV_CITY). Empty disables.
EV_RAIN_HOUR=21
# Habit nudge: local hour to remind about habits not marked yet. Empty disables.
EV_HABIT_NUDGE_HOUR=20
# Proactive nudge: local hour E.V. cobra tarefas atrasadas/vencendo + assinaturas. <0 disables.
EV_NUDGE_HOUR=9
# Continuous learning: local hour E.V. compartilha um padrão que aprendeu sobre você. <0 disables.
EV_LEARN_HOUR=19
# Monthly financial report: day of month + hour. Empty day disables.
EV_MONTHLY_REPORT_DAY=1
EV_MONTHLY_REPORT_HOUR=9
# How often (minutes) to check web monitors (/vigiar).
EV_WATCH_POLL_MINUTES=30
# Send the DB backup to the owner via Telegram (off-VM copy). true/false.
EV_TELEGRAM_BACKUP=true
# Keep only the newest N chat messages per user (bounds DB growth). Facts,
# tasks, reminders, etc. are never pruned.
EV_MESSAGE_HISTORY_KEEP=500

# --- Tools ---

# Web search (DuckDuckGo, no key). true/false.
EV_WEBSEARCH_ENABLED=true
# Better web search (optional). Order of preference: Tavily -> Brave -> DuckDuckGo.
# Tavily (AI-focused, ~1000/month free): https://tavily.com
TAVILY_API_KEY=
# Brave Search API (~2000/month, may require a card): https://brave.com/search/api/
BRAVE_API_KEY=
# Mapillary access token (free) for in-app street-level view: https://www.mapillary.com/dashboard/developers
EV_MAPILLARY_TOKEN=
# Spotify app (OAuth) for playlists + playback control (needs Premium): https://developer.spotify.com/dashboard
EV_SPOTIFY_CLIENT_ID=
EV_SPOTIFY_CLIENT_SECRET=

# Google Calendar & email (optional). One OAuth client serves all your accounts.
# GOOGLE_OAUTH_CLIENT: path to the OAuth client secret JSON from Google Cloud.
# EV_GOOGLE_ACCOUNTS: comma-separated account names; the first is the default.
# Authorize each once: `python authorize_google.py <account>` (caches a token
# per account: google_token_<account>.json). Leave GOOGLE_OAUTH_CLIENT empty to
# disable these tools.
GOOGLE_OAUTH_CLIENT=
EV_GOOGLE_ACCOUNTS=pessoal,faculdade

# Web interface (use E.V. from any browser) — set a strong token to enable it
EV_WEB_TOKEN=
EV_WEB_PORT=8000
