# === E.V. — configuração ===
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env

# Token do bot do Telegram (pegue com o @BotFather)
TELEGRAM_TOKEN=

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo do Gemini (free tier). "gemini-flash-latest" é um alias que sempre
# aponta pro Flash atual — não fica obsoleto. Pode trocar depois.
EV_MODEL=gemini-flash-latest

# --- Fallbacks (opcionais) — se preencher, a E.V. cai neles quando o Gemini
# bate no limite. Deixe vazio para desligar aquele provedor. ---

# Groq (https://console.groq.com/keys) — Llama 3.3 70B + Whisper (transcrição)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter (https://openrouter.ai/keys) — variedade de modelos abertos.
# ATENÇÃO: os modelos ":free" mudam com o tempo. Se der 404, veja os grátis em
# https://openrouter.ai/models?max_price=0 e troque aqui.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Seu ID de usuário no Telegram (opcional, mas RECOMENDADO):
# trava o bot para responder só a você. Descubra mandando /start
# — o E.V. te mostra seu ID nos logs. Deixe vazio para responder a todos.
EV_OWNER_ID=

# Responder por voz? (true/false). Se false, responde só em texto.
EV_VOICE_REPLY=true

# Voz do edge-tts (PT-BR):
#   pt-BR-FranciscaNeural (feminina) · pt-BR-ThalitaMultilingualNeural (feminina)
#   pt-BR-AntonioNeural (masculina)
EV_VOICE=pt-BR-FranciscaNeural

# Ajuste fino da voz (deixa mais meiga): tom mais agudo e fala mais suave.
# Ex: pitch "+20Hz" mais aguda ainda; rate "-10%" bem devagar.
EV_VOICE_RATE=-3%
EV_VOICE_PITCH=+12Hz
